# Dependencias y build
node_modules
dist
dist-ssr
*.local

# Variables de entorno — NUNCA se suben
.env
.env.*
!.env.example

# Notas y credenciales sueltas.
# La clave "anon" de Supabase es pública por diseño (viaja en el bundle),
# pero este patrón de anotar claves en un .txt dentro del proyecto es el
# que un día sube por accidente una clave que sí es secreta (service_role).
*.txt
!LEEME.txt

# Editores y sistema operativo
.claude/
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
Thumbs.db
desktop.ini

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
